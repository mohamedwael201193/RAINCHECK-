{
  "dependencies": {
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "supertest": "^7.3.1",
    "viem": "^2.38.0"
  },
  "description": "RAINCHECK backend: indexer cache over eth_getLogs + receipt API + dashboard. No mock data.",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "name": "raincheck-backend",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "node --watch dist/server.js",
    "indexer": "npm run build && node dist/indexer/selftest.js",
    "start": "node dist/server.js",
    "test": "npm run build && npm run build:test && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "setup:monitors": "npm run build && node dist/webhooks/setup-monitors.js",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "type": "module",
  "version": "0.1.0",
  "optionalDependencies": {
    "@circle-fin/smart-contract-platform": "^10.8.1"
  }
}
