# RAINCHECK backend configuration — public defaults only. No secrets here.
# Copy to .env for local overrides. Never commit a real .env.

# Port the receipt API / dashboard server listens on
PORT=3000

# Arc mainnet public RPC (override with your own endpoint if desired)
RPC_URL=https://rpc.mainnet.arc.io

# RaincheckEscrow PRODUCTION V1 deployment the API indexes
# (arc-5042.json, Sourcify exact_match, challengeWindow 300)
ESCROW_ADDRESS=0x97f233865ae84DC7475F6D7CA404930654580CB5

# First block the API scans on a cold start (deployment block of ESCROW_ADDRESS)
ESCROW_DEPLOY_BLOCK=25956323

# RaincheckEscrow PRODUCTION V1 EURC instance (same source, Sourcify
# exact_match, challengeWindow 300, block 25962288). Multi-asset = one escrow
# instance per token; both are indexed by default. Set empty to watch USDC only.
ESCROW_ADDRESS_EURC=0x3ceba2fbeb27162bfc4888f6b61e48bd359c1e0a

# First block the API scans for the EURC instance on a cold start
ESCROW_DEPLOY_BLOCK_EURC=25962288

# Memo contract used for receipt anchoring (existing infrastructure — never redeployed)
MEMO_ADDRESS=0x5294E9927c3306DcBaDb03fe70b92e01cCede505

# Filesystem path for the SQLite indexer cache (read by backend/src/indexer/config.ts
# as RAINCHECK_DB_PATH).
# On Render, point this at the persistent disk mount (see backend/render.yaml).
RAINCHECK_DB_PATH=/data/raincheck-index.db

# Secret for verifying webhook signatures (HMAC-SHA256).
# No value here on purpose — generate one and set it in your real .env:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
