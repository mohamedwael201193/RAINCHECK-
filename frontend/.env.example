# RAINCHECK frontend — environment
# Copy to .env for local dev. All values here are PUBLIC by design.
# NEVER put private keys, mnemonics, or API secrets in this file.

# Privy App ID (public identifier). Get one at https://dashboard.privy.io
# If unset, wallet connect is gracefully unavailable instead of crashing.
VITE_PRIVY_APP_ID=your-privy-app-id-here

# Receipt API base URL (local backend, backend/ listens on PORT=3000)
VITE_API_URL=http://localhost:3000

# RaincheckEscrow PRODUCTION V1 (arc-5042.json, Sourcify exact_match)
VITE_ESCROW_ADDRESS=0x97f233865ae84DC7475F6D7CA404930654580CB5

# RaincheckEscrow PRODUCTION V1 EURC instance (same source, Sourcify
# exact_match, block 25962288). The USDC|EURC selector on the New Receipt
# page targets this instance for EURC receipts.
VITE_ESCROW_ADDRESS_EURC=0x3ceba2fbeb27162bfc4888f6b61e48bd359c1e0a

# Arc mainnet public RPC
VITE_RPC_URL=https://rpc.mainnet.arc.io
